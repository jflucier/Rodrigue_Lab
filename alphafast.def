Bootstrap: docker
From: nvidia/cuda:12.6.3-base-ubuntu24.04

%environment
    export DEBIAN_FRONTEND=noninteractive
    export UV_COMPILE_BYTECODE=0
    export UV_PROJECT_ENVIRONMENT=/app/alphafold3_venv
    # Fully qualified persistent runtime path mapping
    export PATH="/app/alphafold3_venv/bin:/app/mmseqs/bin:/app/foldseek/bin:/app/uv-aarch64-unknown-linux-musl:/app/hmmer-3.4/bin:$PATH"
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"
    export XLA_CLIENT_MEM_FRACTION=0.95

%post
    export DEBIAN_FRONTEND=noninteractive
    export UV_COMPILE_BYTECODE=0
    export UV_PROJECT_ENVIRONMENT=/app/alphafold3_venv

    # Install system packages (including git)
    apt-get update --quiet \
    && apt-get install --yes --quiet python3.12 python3.12-dev python-is-python3 \
    && apt-get install --yes --quiet git wget gcc g++ make zlib1g-dev zstd pigz \
    && rm -rf /var/lib/apt/lists/*

    # Clone the repository directly into the container filesystem
    mkdir -p /app
    cd /app

    git clone https://github.com/RomeroLab/alphafast.git /app/alphafast

    # Download uv for ARM64
    cd /app
    wget -O uv-aarch64-unknown-linux-musl.tar.gz https://releases.astral.sh/github/uv/releases/download/0.13.6/uv-aarch64-unknown-linux-musl.tar.gz
    tar xvzf uv-aarch64-unknown-linux-musl.tar.gz
    chmod +x /app/uv-aarch64-unknown-linux-musl/uv

    # [Insert HMMER / MMSeqs / Foldseek steps here...]
    cd /app
    wget -O foldseek-linux-arm64.tar.gz https://mmseqs.com/foldseek/foldseek-linux-arm64.tar.gz
    tar xvzf foldseek-linux-arm64.tar.gz
    wget -O mmseqs-linux-gpu-arm64.tar.gz https://github.com/soedinglab/MMseqs2/releases/download/18-8cc5c/mmseqs-linux-gpu-arm64.tar.gz
    tar xvzf mmseqs-linux-gpu-arm64.tar.gz

    wget -O hmmer-3.4.tar.gz http://eddylab.org/software/hmmer/hmmer.tar.gz
    tar xvzf hmmer-3.4.tar.gz
    cd hmmer-3.4/
    ./configure --prefix=/app/hmmer-3.4/
    make
    make check                        # optional: automated tests
    make install                      # optional: install HMMER programs and man pages
    cd easel && make install

    # Build the Python environment inside the cloned directory
    export PATH="/app/alphafold3_venv/bin:/app/mmseqs/bin:/app/foldseek/bin:/app/uv-aarch64-unknown-linux-musl:/app/hmmer-3.4/bin:$PATH"
    cd /app/alphafast
    uv sync --frozen --all-groups --no-editable
    uv run build_data

%test
    # Map the runtime binary environment
    export PATH="/app/alphafold3_venv/bin:/app/uv-aarch64-unknown-linux-musl:/app/mmseqs/bin:/app/foldseek/bin:/app/hmmer/bin:$PATH"

    echo "=== Running Container Verification Tests ==="

    echo "Checking core third-party dependencies..."
    jackhmmer -h > /dev/null && echo "✓ jackhmmer (HMMER) is available"
    mmseqs -h > /dev/null && echo "✓ mmseqs is available"
    foldseek -h > /dev/null && echo "✓ foldseek is available"

    echo "Checking AlphaFast runtime script availability..."
    cd /app/alphafast
    if [ -f "scripts/run_alphafast.sh" ]; then
        echo "✓ scripts/run_alphafast.sh file exists"
        chmod +x scripts/run_alphafast.sh
    else
        echo "ERROR: scripts/run_alphafast.sh not found!"
        exit 1
    fi

    echo "Verifying runtime script help invocation..."
    # Execute the target file via python environment to ensure it evaluates flags safely
    ./scripts/run_alphafast.sh --help > /dev/null
    echo "✓ scripts/run_alphafast.sh executed successfully with --help"

    echo "=== All Tests Passed Successfully ==="

%runscript
    cd /app/alphafast
    export PATH="/app/alphafold3_venv/bin:/app/uv-aarch64-unknown-linux-musl:/app/mmseqs/bin:/app/foldseek/bin:/app/hmmer/bin:$PATH"
    exec ./scripts/run_alphafast.sh "$@"
Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Install necessary system build tools and structural animation packages
    apt-get update && apt-get install -y \
        git wget cmake build-essential \
        python3-pip python3-dev python3-venv \
        kalign \
        && rm -rf /var/lib/apt/lists/*

    # 2. Upgrade pip and optimize core Python environment parameters
    pip3 install --no-cache-dir --upgrade pip setuptools wheel

    # 3. Install JAX with explicit CUDA 12 support for GPU acceleration
    pip3 install --no-cache-dir "jax[cuda12]"

    # 4. Clone and install ColabDesign (including sidechain rotamer modules)
    git clone https://github.com/sokrypton/ColabDesign.git /opt/ColabDesign
    cd /opt/ColabDesign
    pip3 install --no-cache-dir .

    # 5. Pre-download AlphaFold v2 weights inside the container
    # This prevents worker nodes from timing out or hitting networking bottlenecks mid-simulation
    mkdir -p /opt/ColabDesign/params
    cd /opt/ColabDesign/params

    echo "Downloading AlphaFold structural parameters..."
    # Download the essential multi-chain and monomer v2 parameter tracks
    wget -q https://storage.googleapis.com/alphafold/alphafold_params_2022-12-06.tar
    tar -xf alphafold_params_2022-12-06.tar
    rm -f alphafold_params_2022-12-06.tar

    if [ -d "alphafold" ]; then
        mv alphafold/* .
        rm -rf alphafold
    fi

%environment
    export LC_ALL=C
    # Set paths so Python can discover ColabDesign weights and libraries instantly
    export PYTHONPATH=/opt/ColabDesign:$PYTHONPATH
    export ALPHAFOLD_PARAMS_PATH=/opt/ColabDesign/params

    # Force JAX/XLA to optimize GPU memory allocation flags on high-throughput clusters
    export XLA_PYTHON_CLIENT_PREALLOCATE=true
    export XLA_PYTHON_CLIENT_MEM_FRACTION=0.85

%runscript
    # Allows executing scripts programmatically via: singularity run --nv container.sif script.py
    exec python3 "$@"

Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.2.2-runtime-ubuntu22.04

# afcycdesign_gh200.def
#
# ColabDesign/AfCycDesign container for step 4 of the macrocycle pipeline.
# GH200 is aarch64 -- unlike PyRosetta (no linux/aarch64 wheel, hence the
# from-source Rosetta build), JAX's pip CUDA wheels DO support aarch64+GPU
# (confirmed against JAX's install docs: "JAX provides pre-built
# CUDA-compatible wheels for Linux x86_64 and Linux aarch64 only"), so a
# plain pip install is the right approach here, not a from-source build.

%post
    set -e   # abort the build on any failed command -- a truncated/partial
             # AlphaFold params download (a known, documented failure mode
             # for this exact 5.2GB file -- see martinpacesa/BindCraft#54)
             # must not be allowed to silently produce a "successful" image
             # with broken or incomplete weights.
    export DEBIAN_FRONTEND=noninteractive

    # 1. Install necessary system build tools
    apt-get update && apt-get install -y \
        git wget cmake build-essential \
        python3-pip python3-dev python3-venv \
        && rm -rf /var/lib/apt/lists/*

    # 2. Upgrade pip and optimize core Python environment parameters
    pip3 install --no-cache-dir --upgrade pip setuptools wheel

    # 3. Clone and install ColabDesign first
    git clone https://github.com/sokrypton/ColabDesign.git /opt/ColabDesign
    cd /opt/ColabDesign
    git checkout 6d3837d94a63df561e73477dfdd553b0cf894a90
    pip3 install --no-cache-dir .

    # 4. FORCE-PIN JAX & JAXLIB to Python 3.10 compatible versions
    # This explicitly overrides any unpinned packages pulled in by ColabDesign.
    pip3 install --no-cache-dir --force-reinstall \
        "jax==0.4.30" \
        "jaxlib==0.4.30" \
        "jax-cuda12-plugin" \
        "nvidia-nccl-cu12"


    # 5. Pre-download AlphaFold v2 weights inside the container
    mkdir -p /opt/ColabDesign/params
    cd /opt/ColabDesign/params

    echo "Downloading AlphaFold structural parameters..."
    PARAMS_URL="https://storage.googleapis.com/alphafold/alphafold_params_2022-12-06.tar"
    PARAMS_TAR="alphafold_params_2022-12-06.tar"
    EXPECTED_SIZE=5587968000   # bytes, from the known-good download in BindCraft#54

    wget --tries=3 -O "${PARAMS_TAR}" "${PARAMS_URL}"

    ACTUAL_SIZE=$(stat -c%s "${PARAMS_TAR}")
    if [ "${ACTUAL_SIZE}" -ne "${EXPECTED_SIZE}" ]; then
        echo "CRITICAL: downloaded params tar is ${ACTUAL_SIZE} bytes, expected ${EXPECTED_SIZE}."
        echo "Download was truncated or the upstream file changed -- aborting build rather "
        echo "than ship a container with broken/partial AlphaFold weights."
        exit 1
    fi

    tar -xf "${PARAMS_TAR}"
    rm -f "${PARAMS_TAR}"

    N_NPZ=$(ls -1 *.npz 2>/dev/null | wc -l)
    echo "Extracted ${N_NPZ} .npz parameter files."
    if [ "${N_NPZ}" -lt 1 ]; then
        echo "CRITICAL: no .npz files after extraction."
        exit 1
    fi

%environment
    export LC_ALL=C
    export PYTHONPATH=/opt/ColabDesign:$PYTHONPATH
    export ALPHAFOLD_PARAMS_PATH=/opt/ColabDesign/params

    export XLA_PYTHON_CLIENT_PREALLOCATE=true
    export XLA_PYTHON_CLIENT_MEM_FRACTION=0.85

%runscript
    exec python3 "$@"

%test
    set -e
    echo "============================================================"
    echo "RUNNING BUILD-TIME CONTAINER INTEGRITY CHECKS"
    echo "============================================================"

    # 1. Verify AlphaFold parameter file COUNT, not just "at least one file"
    N_NPZ=$(ls -1 /opt/ColabDesign/params/*.npz 2>/dev/null | wc -l)
    echo "  --> found ${N_NPZ} .npz parameter files"
    if [ "${N_NPZ}" -lt 10 ]; then
        echo "  --> [FAIL] Expected many .npz files (monomer + multimer model sets); "
        echo "             only ${N_NPZ} found -- extraction likely incomplete."
        exit 1
    fi
    echo "  --> [PASS] AlphaFold .npz parameter files verified."

    # 2. Verify Python imports (NOT a GPU check -- see note below)
    python3 -c "
import sys
try:
    import jax
    import colabdesign
    print(f'  --> [PASS] JAX Version {jax.__version__} and ColabDesign imported cleanly.')
except ImportError as e:
    print(f'  --> [FAIL] Package import error occurred: {e}')
    sys.exit(1)
"
    echo "============================================================"
    echo "ALL BUILD-TIME INTEGRITY CHECKS PASSED"
    echo "============================================================"
    echo "NOTE: this does NOT confirm GPU/CUDA actually works -- 'apptainer build'"
    echo "runs %test without GPU access, so jax.devices() would show CPU-only here"
    echo "even on a correctly-built image. Confirm GPU separately, after build, with:"
    echo "  apptainer exec --nv afcycdesign_gh200.sif python3 -c \"import jax; print(jax.devices())\""
    echo "and check the output lists a CudaDevice / GpuDevice, not just CPU."

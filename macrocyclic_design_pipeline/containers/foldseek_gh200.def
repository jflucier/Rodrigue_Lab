Bootstrap: docker
From: nvidia/cuda:12.6.3-base-ubuntu24.04

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Install necessary system build tools
    apt-get update && apt-get install -y \
        git \
        cmake \
        build-essential \
        python3-pip \
        python3-dev \
        kalign \
        wget \
        ca-certificates \
        && rm -rf /var/lib/apt/lists/*

    pip3 install --no-cache-dir --break-system-packages torch torchvision --index-url https://download.pytorch.org/whl/cu126

    pip3 install --no-cache-dir --break-system-packages \
        "jax[cuda12]"

    cd /opt
    wget https://mmseqs.com/foldseek/foldseek-linux-gpu-arm64.tar.gz
    tar -xvzf foldseek-linux-gpu-arm64.tar.gz
    rm -f foldseek-linux-gpu-arm64.tar.gz

%environment
    export LC_ALL=C
    export PATH="/opt/foldseek/bin/:$PATH"
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"
    export XLA_CLIENT_MEM_FRACTION=0.95

%runscript
    exec foldseek "$@"

%test
    echo "=== 1. Validating Architecture & Binaries ==="
    uname -m | grep -q "aarch64" && echo "Architecture: aarch64 (ARM64) OK"
    export PATH="/opt/foldseek/bin:$PATH"
    which foldseek && foldseek version
    which kalign

    echo "=== 2. Validating PyTorch ==="
    python3 -c "import torch; print('PyTorch:', torch.__version__, '| CUDA available:', torch.cuda.is_available())"

    echo "=== 3. Validating JAX & XLA Execution ==="
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"
    export XLA_CLIENT_MEM_FRACTION=0.95
    python3 -c "
import jax, jax.numpy as jnp
print('JAX version:', jax.__version__)
print('JAX backend:', jax.default_backend())
print('JAX devices:', jax.devices())
x = jax.jit(lambda a: a * a)(jnp.arange(4)).block_until_ready()
assert int(x.sum()) == 14
print('JAX JIT computation test: PASSED')
"

    echo "=== All checks passed! ==="
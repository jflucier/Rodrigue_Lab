Bootstrap: localimage
From: ./rosetta_pyrosetta.clean.sif

%post
    export DEBIAN_FRONTEND=noninteractive

    # Install PyTorch (CPU version is standard for portability, or omit --extra-index-url for GPU)
    pip3 install torch torchvision --index-url https://download.pytorch.org/whl/cu126

    # Download ProteinMPNN into /opt
    mkdir -p /opt/proteinmpnn
    git clone https://github.com/dauparas/ProteinMPNN.git /opt/proteinmpnn

%environment
    export PATH=/opt/proteinmpnn:$PATH

%test
    set -e
    echo "=== Verify: rosetta_scripts ==="
    /opt/rosetta/source/bin/rosetta_scripts.linuxgccrelease -help > /dev/null && echo "OK: rosetta_scripts works"

    echo "=== Verify: PyRosetta ==="
    python3 -c "import pyrosetta; pyrosetta.init('-mute all'); print('OK: PyRosetta version:', pyrosetta.version())"

    echo "=== Verify: ProteinMPNN ==="
    python3 /opt/proteinmpnn/protein_mpnn_run.py --help > /dev/null && echo "OK: ProteinMPNN script works"


Bootstrap: docker
From: nvcr.io/nvidia/dgl:24.06-py3

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Install necessary system build tools
    apt-get update && apt-get install -y \
        cmake build-essential python3-pip python3-dev \
        && rm -rf /var/lib/apt/lists/*

    # 2. Install purely python-level dependencies from internal fallback caches
    pip3 install --no-cache-dir \
        pyyaml hydra-core omegaconf icecream pyrsistent e3nn scipy pydantic

#    pip3 install --no-cache-dir dgl -f https://data.dgl.ai/wheels/torch-2.4/repo.html

    git clone https://github.com/RosettaCommons/RFdiffusion.git /opt/RFdiffusion
    mkdir /opt/RFdiffusion/models && cd /opt/RFdiffusion/models
    wget http://files.ipd.uw.edu/pub/RFdiffusion/6f5902ac237024bdd0c176cb93063dc4/Base_ckpt.pt
    wget http://files.ipd.uw.edu/pub/RFdiffusion/e29311f6f1bf1af907f9ef9f44b8328b/Complex_base_ckpt.pt
    wget http://files.ipd.uw.edu/pub/RFdiffusion/60f09a193fb5e5ccdc4980417708dbab/Complex_Fold_base_ckpt.pt
    wget http://files.ipd.uw.edu/pub/RFdiffusion/74f51cfb8b440f50d70878e05361d8f0/InpaintSeq_ckpt.pt
    wget http://files.ipd.uw.edu/pub/RFdiffusion/76d00716416567174cdb7ca96e208296/InpaintSeq_Fold_ckpt.pt
    wget http://files.ipd.uw.edu/pub/RFdiffusion/5532d2e1f3a4738decd58b19d633b3c3/ActiveSite_ckpt.pt
    wget http://files.ipd.uw.edu/pub/RFdiffusion/12fc204edeae5b57713c5ad7dcb97d39/Base_epoch8_ckpt.pt
    wget http://files.ipd.uw.edu/pub/RFdiffusion/f572d396fae9206628714fb2ce00f72e/Complex_beta_ckpt.pt
    wget http://files.ipd.uw.edu/pub/RFdiffusion/1befcb9b28e2f778f53d47f18b7597fa/RF_structure_prediction_weights.pt

    cd /opt/RFdiffusion/env/SE3Transformer
    pip install --no-cache-dir -r requirements.txt
    python setup.py install

    cd /opt/RFdiffusion
    pip install --no-cache-dir -e .

%environment
    export LC_ALL=C
    export PATH=/opt/RFdiffusion/scripts:$PATH
    export DGLBACKEND="pytorch"

%runscript
    python3 /opt/RFdiffusion/scripts/run_inference.py "$@"

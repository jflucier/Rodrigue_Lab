Bootstrap: docker
From: ubuntu:22.04

# singularity build --bind /home/jflucier/programs/rosetta:/mnt \
# rosetta_pyrosetta.sif rosetta_pyrosetta_build.def

%arguments
    NUM_JOBS=8

%post
    export DEBIAN_FRONTEND=noninteractive

    # --- THE SYSTEM TRICK: Manually seed the _ssh group ---
    # This directly provides the group ID so that chgrp doesn't crash,
    # bypassing the broken groupadd tool entirely.
    echo "_ssh:x:101:" >> /etc/group

    # --- THE ABSOLUTE BYPASS: Divert groupadd to /bin/true ----------------
    # This prevents any apt package (now or during updates) from trying
    # to modify /etc/group under your restricted environment.
    rm -f /sbin/groupadd /usr/sbin/groupadd
    ln -sf /bin/true /sbin/groupadd
    ln -sf /bin/true /usr/sbin/groupadd

    apt-get update && apt-get install -y \
        build-essential git cmake ninja-build \
        clang llvm \
        python3 python3-dev python3-pip python-is-python3 \
        zlib1g-dev libbz2-dev \
        wget curl ca-certificates
    rm -rf /var/lib/apt/lists/*

    # --- Copy from bind-mounted host folder -------------------------------
    echo "Copying Rosetta source code from bind mount..."
    mkdir -p /opt/rosetta
    cp -a /mnt/. /opt/rosetta/

    pip3 install --no-cache-dir scons

    echo "Copying Rosetta source code from bind mount..."
    mkdir -p /opt/rosetta
    # Using 'cp -a' preserves symlinks as links and won't crash on broken ones
    cp -a /mnt/. /opt/rosetta/

    # --- Build Rosetta C++ Core (rosetta_scripts) ------------------------
    cd /opt/rosetta/source
    ./scons.py -j{{ NUM_JOBS }} mode=release rosetta_scripts

    # --- Build and Install PyRosetta -------------------------------------
    cd /opt/rosetta/source/src/python/PyRosetta
    export CC=clang
    export CXX=clang++
    python3 build.py -j{{ NUM_JOBS }} --create-wheel /opt/pyrosetta_wheel
    pip3 install --no-cache-dir /opt/pyrosetta_wheel/*.whl

    # --- Post-Build Size Optimization & Cleanup --------------------------
    rm -rf /opt/rosetta/source/src/python/PyRosetta/build/CMakeFiles
    rm -rf /opt/rosetta/source/build/
    find /opt/rosetta/source/src/ -type f -name "*.o" -delete
    find /opt/rosetta/source/src/ -type f -name "*.os" -delete
    find /opt/rosetta/source/src/ -type f -name "*.a" -delete

    if [ -f "/opt/rosetta/source/bin/rosetta_scripts.linuxgccrelease" ]; then
        strip --strip-unneeded /opt/rosetta/source/bin/rosetta_scripts.linuxgccrelease
    fi

    # Safely strip only unneeded symbols from PyRosetta compiled .so libraries
    find /usr/local/lib/python3.10/dist-packages/pyrosetta/ -name "*.so" -exec strip --strip-unneeded {} + 2>/dev/null || true

%environment
    export LC_ALL=C
    export PATH=/opt/rosetta/source/bin:$PATH
    export ROSETTA3_DB=/opt/rosetta/database
    export ROSETTA3=/opt/rosetta

%test
    set -e
    echo "=== rosetta_scripts binary ==="
    /opt/rosetta/source/bin/rosetta_scripts.linuxgccrelease -help > /dev/null && echo "OK: rosetta_scripts runs"

    echo "=== PyRosetta import ==="
    python3 -c "import pyrosetta; pyrosetta.init('-mute all'); print('OK: PyRosetta version:', pyrosetta.version())"

%runscript
    exec "$@"

%help
    Rosetta (rosetta_scripts binary, release mode) + PyRosetta, built from
    source. Used by the macrocycle pipeline's steps 3 (FastRelax +
    PeptideCyclizeMover) and 5 (Rosetta ddG/SAP/CMS interface metrics).

    Run rosetta_scripts:
        apptainer exec rosetta_pyrosetta.sif rosetta_scripts.linuxgccrelease -parser:protocol my.xml ...

    Run a PyRosetta script:
        apptainer exec rosetta_pyrosetta.sif python3 my_relax_script.py

    Note the binary name has no ".default" infix (that's specific to
    RosettaCommons' prebuilt binary bundles) -- it's
    rosetta_scripts.linuxgccrelease here, not rosetta_scripts.default.linuxgccrelease.
    Update --rosetta-bin in scripts/05_rosetta_filter.py accordingly.
